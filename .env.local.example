ANTHROPIC_API_KEY=
# Optional keyed male neural speech for Pilot. Without these keys Pilot uses
# Microsoft Edge online male Neural voices (Andrew, Dmitry, Ostap, …) — no key.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
OPENAI_API_KEY=
OPENAI_TTS_VOICE=onyx
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
TTS_PROVIDER=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXTAUTH_URL=http://127.0.0.1:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local: postgresql://starwall:starwall@127.0.0.1:5432/starwall
# Production: Neon / Vercel Postgres pooled URI. Add ?sslmode=require if missing.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/starwall?sslmode=require
# Optional override for the persistent owner Super Admin (defaults are in seed).
STARWALL_OWNER_EMAIL=
STARWALL_OWNER_PASSWORD=
